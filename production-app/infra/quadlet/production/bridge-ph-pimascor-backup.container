# Active production backup template. Use production-only secrets and repository;
# never substitute demo credentials.
[Unit]
Description=Back up PIMASCOR production files, Quadlets, and PostgreSQL dump to Backblaze B2
After=bridge-ph-pimascor-db-dump.service
Requires=bridge-ph-pimascor-db-dump.service

[Container]
Image=docker.io/restic/restic@sha256:08916bcda4a4435f9d9828ebb4e91bb7ada3d2c8a53699788930e0ae1bd4fa67
Pull=missing
ContainerName=bridge-ph-pimascor-backup
Network=bridge-ph-pimascor-egress.network
Secret=bridge_ph_pimascor_b2_key_id,type=env,target=AWS_ACCESS_KEY_ID
Secret=bridge_ph_pimascor_b2_application_key,type=env,target=AWS_SECRET_ACCESS_KEY
Secret=bridge_ph_pimascor_restic_password,target=restic_password,uid=0,gid=0,mode=0400
Environment=AWS_DEFAULT_REGION=us-west-001
Environment=RESTIC_REPOSITORY=s3:https://s3.us-west-001.backblazeb2.com/bridge-ph/pimascor/backups/restic
Environment=RESTIC_PASSWORD_FILE=/run/secrets/restic_password
Environment=RESTIC_CACHE_DIR=/cache
Volume=%h/bridge-ph/pimascor:/pimascor:ro
Volume=%h/.config/containers/systemd/bridge-ph/pimascor:/quadlets:ro
Volume=%h/bridge-ph/pimascor/restic-cache:/cache
SecurityLabelDisable=true
Exec=backup /pimascor /quadlets --exclude=/pimascor/data/postgres --exclude=/pimascor/restic-cache --tag=bridge-ph-pimascor-production --host=bridge-ph-pimascor-production
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp:rw,size=128m,mode=1777
NoNewPrivileges=true
DropCapability=all
PidsLimit=256
Memory=2g
RunInit=true
LogDriver=journald

[Service]
Type=oneshot
Restart=no
TimeoutStartSec=7200
# Keep cleanup before catalog recording: systemd runs ExecStartPost hooks in
# declaration order, and a cleanup failure must fail this backup unit.
ExecStartPost=%h/bridge-ph/pimascor/bin/cleanup-production-backup-staging.sh
ExecStartPost=%h/bridge-ph/pimascor/bin/record-production-backup.sh
