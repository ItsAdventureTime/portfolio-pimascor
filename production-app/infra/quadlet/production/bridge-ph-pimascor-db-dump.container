# Active production template. It requires the database network and production
# secrets, which update-production.sh verifies before installation.
[Unit]
Description=Create a consistent PostgreSQL dump for the PIMASCOR production backup
After=bridge-ph-pimascor-db.service
Requires=bridge-ph-pimascor-db.service

[Container]
Image=docker.io/library/postgres:18-alpine
Pull=missing
ContainerName=bridge-ph-pimascor-db-dump
Network=bridge-ph-pimascor-data.network
Secret=bridge_ph_pimascor_pgpass,target=pgpass,uid=0,gid=0,mode=0400
Environment=PGPASSFILE=/run/secrets/pgpass
Volume=%h/bridge-ph/pimascor/backup-staging:/backup:Z
Exec=pg_dump --host=database --port=5432 --username=pimascor --dbname=pimascor --format=custom --compress=6 --no-owner --no-privileges --file=/backup/postgres.dump
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp:rw,size=64m,mode=1777
NoNewPrivileges=true
DropCapability=all
PidsLimit=128
Memory=1g
RunInit=true
LogDriver=journald

[Service]
Type=oneshot
Restart=no
TimeoutStartSec=1800
