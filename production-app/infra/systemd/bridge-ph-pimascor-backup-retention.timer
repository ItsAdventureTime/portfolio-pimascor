# Active production schedule. Change only through the production change record.
[Unit]
Description=Prune expired PIMASCOR production snapshots every Sunday

[Timer]
OnCalendar=Sun *-*-* 05:00:00 Asia/Manila
Persistent=true
AccuracySec=5min
Unit=bridge-ph-pimascor-backup-retention.service

[Install]
WantedBy=timers.target
