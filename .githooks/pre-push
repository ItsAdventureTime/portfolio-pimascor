#!/bin/sh
set -eu

remote_name="${1:-}"
remote_url="${2:-}"
approved_remote='https://github.com/ItsAdventureTime/portfolio-pimascor.git'

if [ "${remote_url}" != "${approved_remote}" ] ||
   [ "${PIMASCOR_ALLOW_PORTFOLIO_GITHUB_PUSH:-}" != '1' ]; then
  printf '%s\n' 'Push blocked: only the owner-approved portfolio GitHub remote is allowed.' >&2
  printf '%s\n' 'Review staged content for public exposure, then use PIMASCOR_ALLOW_PORTFOLIO_GITHUB_PUSH=1 with git push.' >&2
  exit 1
fi

printf 'Authorized portfolio push: %s (%s)\n' "${remote_name}" "${remote_url}" >&2
